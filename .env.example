# ==============================================================================
# 🌐 AWS RDS & 데이터베이스 환경 변수 설정 (.env)
# ==============================================================================

# [선택 1] DB_TYPE을 지정하여 개별 항목 설정 (postgresql, mysql, mariadb, sqlite)
# AWS RDS PostgreSQL 사용 시: DB_TYPE=postgresql
# AWS RDS MySQL 사용 시: DB_TYPE=mysql
# 기본 로컬 개발용: DB_TYPE=sqlite
DB_TYPE=postgresql

# AWS RDS 엔드포인트 호스트주소 (예: secops-db.c123456789.ap-northeast-2.rds.amazonaws.com)
DB_HOST=secops-rds.c123456789.ap-northeast-2.rds.amazonaws.com

# AWS RDS 데이터베이스 포트 (PostgreSQL: 5432, MySQL: 3306)
DB_PORT=5432

# AWS RDS 데이터베이스 이름
DB_NAME=secops_db

# AWS RDS 마스터 사용자 이름 (User)
DB_USER=postgres

# AWS RDS 마스터 비밀번호 (Password)
DB_PASSWORD=your_rds_password

# AWS RDS SSL 보안 연결 여부 (true / false)
DB_SSL=false

# 커넥션 풀 크기 설정
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# [선택 2] 연결 URL을 직접 수동으로 입력하려는 경우 (설정 시 위 항목보다 최우선 적용)
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@your-rds-endpoint.rds.amazonaws.com:5432/secops_db
# ------------------------------------------------------------------------------
